# Monkeybook environment variables
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development

# Admin: comma-separated emails that get is_admin on register
ADMIN_EMAILS=you@example.com

# Google OAuth (optional)
# Server: GOOGLE_CLIENT_ID — Client build: VITE_GOOGLE_CLIENT_ID (same value)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Email for password reset (optional in dev — link logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# PostgreSQL (production — leave unset for local SQLite)
DATABASE_URL=
DATABASE_SSL=false

# Cloudflare R2 (optional — leave unset for local file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Production CORS (your frontend URL)
CLIENT_ORIGIN=https://your-app.up.railway.app

# Job queue / workers
# In production: run a separate Railway service with `node server/worker.js`
# EMBEDDED_WORKER=true runs the worker inside the web process (single-instance only)
EMBEDDED_WORKER=false
WORKER_POLL_MS=1000
# Jobs stuck in processing longer than this are requeued (default 5 minutes)
JOB_PROCESSING_TIMEOUT_MS=300000
# SYNC_JOBS=1 processes jobs inline (tests only)

# Metrics endpoints for autoscaling (/api/metrics/load, /api/metrics/queue)
# If set, autoscaler and probes must send Authorization: Bearer <token>
METRICS_TOKEN=

# Autoscaler (separate Railway service — node autoscaler/index.js)
# RAILWAY_API_TOKEN=           # Project token from Railway project settings
# RAILWAY_TOKEN_TYPE=project   # project | account
# AUTOSCALE_WEB_ENABLED=true
# AUTOSCALE_WEB_SERVICE_ID=
# AUTOSCALE_WEB_ENVIRONMENT_ID=
# AUTOSCALE_WEB_LOAD_URL=https://your-app.up.railway.app/api/metrics/load
# AUTOSCALE_WEB_TARGET_INFLIGHT=25
# AUTOSCALE_WEB_MIN_REPLICAS=1
# AUTOSCALE_WEB_MAX_REPLICAS=10
# AUTOSCALE_WORKER_ENABLED=false
# AUTOSCALE_WORKER_SERVICE_ID=
# AUTOSCALE_WORKER_QUEUE_URL=http://monkeybook.railway.internal/api/metrics/queue
# AUTOSCALE_WORKER_TARGET_JOBS=20
# AUTOSCALE_POLL_INTERVAL_MS=60000
# AUTOSCALE_SCALE_DOWN_COOLDOWN_MS=300000
