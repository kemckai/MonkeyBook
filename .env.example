# Monkeybook environment variables
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development

# Admin: comma-separated emails that get is_admin on register
ADMIN_EMAILS=you@example.com

# Google OAuth (optional) — also set VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_CLIENT_ID=

# Email for password reset (optional in dev — link logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# PostgreSQL (production — leave unset for local SQLite)
DATABASE_URL=
DATABASE_SSL=false

# Cloudflare R2 (optional — leave unset for local file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Production CORS (your frontend URL)
CLIENT_ORIGIN=https://your-app.up.railway.app
